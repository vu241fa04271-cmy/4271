# Copy this file to ".env" and replace the values with strong random secrets.
# Generate a secret key, e.g. with:  python -c "import secrets; print(secrets.token_hex(32))"

# Flask session signing secret (used for flashing/errors).
SECRET_KEY=replace-with-a-random-secret

# JWT signing secret for authentication tokens.
JWT_SECRET_KEY=replace-with-another-random-secret

# How long a login token stays valid (in hours).
JWT_EXPIRATION_HOURS=24

# SQLite database URI. Default creates backend/instance/womens_safety.db
DATABASE_URL=sqlite:///instance/womens_safety.db

# Comma-separated list of allowed frontend origins for production, or "*".
CORS_ORIGINS=*

# Flask environment: development | production
FLASK_ENV=development

# --- Twilio SMS notifications (optional but recommended for SOS alerts) ---
# Get these from the Twilio Console: https://console.twilio.com
# Leave blank to disable SMS (alerts are still recorded; notifications show as
# failed with a clear "not configured" reason).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A Twilio phone number in E.164 format, e.g. +12345678900
TWILIO_PHONE_NUMBER=+12345678900
# Public base URL of this backend so Twilio can POST delivery status back.
# Use your ngrok/cloudflare tunnel URL for local testing (no trailing slash).
# Example: https://abcd-12-34-56-78.ngrok-free.app
TWILIO_STATUS_CALLBACK_URL=
# Validate the X-Twilio-Signature on the status webhook (true in production).
# Set to false only for quick local manual testing.
TWILIO_VALIDATE_SIGNATURE=true
