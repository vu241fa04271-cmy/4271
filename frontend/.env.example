# Copy this file to ".env" and adjust as needed.
# When using the Vite dev proxy (vite.config.js proxies /api -> http://localhost:5000),
# you can leave this empty so the frontend calls /api and the proxy forwards it.
#
# If you are NOT using the dev proxy (e.g. running a production build), point the
# frontend directly at the Flask backend:
#   VITE_API_URL=http://localhost:5000/api
VITE_API_URL=
